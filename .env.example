# Copy this file to .env (same folder) and fill in your own key. Never commit .env.
ANTHROPIC_API_KEY=

# Which provider runs the model ("anthropic" has built-in web search).
PROVIDER=anthropic
# Optional: a different writer model (default: claude-sonnet-5-5).
# WRITER_MODEL=

# Prices (USD per million tokens) for the cost line, from https://docs.anthropic.com/en/docs/about-claude/pricing
PRICE_IN=2
PRICE_OUT=10
PRICE_CACHE_WRITE=2.50
PRICE_CACHE_READ=0.10
PRICE_SEARCH_PER_1000=10

# Warn at 75% of this (dollars); at 100%, pressing Enter writes the final brief.
RUN_BUDGET=5.00

# Checks: 0 turns the fact checker off. Optional different models for the checker and the skeptic.
FACT_CHECK=1
# FACT_CHECK_MODEL=
# SKEPTIC_MODEL=
